{
  "name": "dsh-aipais-image",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 生图工具：通过 aipais.de 中转调用 gpt-image-2.6，一条工具调用完成生成 + 落盘 + 返回可粘贴的 Markdown，并在会话里内联预览图片。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "selftest.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
