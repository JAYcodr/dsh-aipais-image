{
  "name": "dsh-aipais-image",
  "version": "0.3.0",
  "private": true,
  "description": "DSH 生图工具：通过 aipais.de 中转调用 gpt-image-2.6，一次工具调用完成生成（支持多提示词）+ 落盘 + 元数据账本 + 可粘贴 Markdown，并在会话里内联预览图片。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "selftest.mjs"
  ],
  "scripts": {
    "test": "node test/offline.mjs",
    "selftest": "node selftest.mjs --info"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
